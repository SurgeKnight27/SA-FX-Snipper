[app]

# (str) Title of your application
title = Surge-Sniper

# (str) Package name
package.name = surgesniper

# (str) Package domain
package.domain = com.surgesniper

# (str) Source code where main.py is located
source.dir = .

# (list) Source files to include
source.include_exts = py,png,jpg,jpeg,kv,json

# (str) Application version
version = 3.7.3

# (list) Supported orientations
orientation = portrait


# (list) Application requirements
requirements = python3,kivy


# (str) Icon file
icon.filename = Assets/logo.jpg


# (str) Presplash
presplash.filename = Assets/logo.jpg


# (bool) Fullscreen mode
fullscreen = 0


[buildozer]

# (int) Log level
log_level = 2

# (int) Warn if buildozer is run as root
warn_on_root = 1
